[Unit]
Description=lightweight-stt push-to-talk dictation
After=graphical-session.target ydotoold.service
Wants=ydotoold.service
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=@INSTALL_DIR@
Environment=YDOTOOL_SOCKET=%t/.ydotool_socket
ExecStart=@INSTALL_DIR@/venv/bin/python -m stt.main
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
